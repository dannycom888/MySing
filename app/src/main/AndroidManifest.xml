<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Local network only: the phone-ordering HTTP server and the LAN
         address it is reached at. No internet service is used; the
         INTERNET permission exists solely so the app can *serve* the
         ordering page to phones on the same Wi-Fi. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- Voice search (v1.0.46): the browse page's 🎤 button feeds
         the device's own speech-recognition service. This is the
         ONLY permission this feature adds — recognition runs in
         the system service, not in this app, and the microphone
         hears search commands only, never the singing (the sing
         microphone is a separate amp chain the app never touches). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Android 11+ package visibility: without this, the speech
         recognition service is invisible to the app and
         SpeechRecognizer.isRecognitionAvailable wrongly reports
         false on devices that do have one. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <!-- TV-capable but NOT TV-only: the user trials the app on a
         Galaxy Note10+ phone first, so leanback is optional and a
         plain LAUNCHER entry exists beside LEANBACK_LAUNCHER. -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <application
        android:name=".KaraokeApp"
        android:allowBackup="true"
        android:banner="@drawable/app_banner"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ShieldKaraoke"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".ui.MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="true"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
